<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ff079bd3" />
            <corners android:radius="10.0dp" />
            <stroke android:width="1.0dp" android:color="#ffefefef" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#ff10b5f6" />
            <corners android:radius="10.0dp" />
            <stroke android:width="1.0dp" android:color="#ffefefef" />
        </shape>
    </item>
</selector>
